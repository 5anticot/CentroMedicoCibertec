<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CentroMédicoCibertec"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <activity
            android:name=".ui.view.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.view.CitasDisponiblesActivity"
            android:parentActivityName=".ui.view.MainActivity" />
        <activity
            android:name=".ui.view.MisCitasActivity"
            android:parentActivityName=".ui.view.MainActivity" />
        <activity
            android:name=".ui.view.DoctorCitasActivity"
            android:label="Portal de Doctor"
            android:parentActivityName=".ui.view.MainActivity" />
        <activity
            android:name=".ui.view.CrearCitaActivity"
            android:label="Crear Nueva Cita"
            android:parentActivityName=".ui.view.DoctorCitasActivity" />
    </application>

</manifest>